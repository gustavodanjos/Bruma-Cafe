<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/brumacafe/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="brumacafe/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="brumacafe/components/container"
            layout="simple">
            <image
                jcr:primaryType="nt:unstructured"
                sling:resourceType="brumacafe/components/image"
                fileReference="/content/dam/brumacafe/logo.svg"
                alt="Bruma Café"
                linkURL="/content/brumacafe/us/en.html"/>
            <navigation
                jcr:primaryType="nt:unstructured"
                sling:resourceType="brumacafe/components/navigation"
                collectAllPages="false"
                navigationRoot="/content/brumacafe/us/en"
                skipNavigationRoot="false"
                structureDepth="1"/>
            <languagenavigation
                jcr:primaryType="nt:unstructured"
                sling:resourceType="brumacafe/components/languagenavigation"
                navigationRoot="/content/brumacafe/us"
                structureDepth="2"/>
            <search
                jcr:primaryType="nt:unstructured"
                sling:resourceType="brumacafe/components/search"
                searchRoot="/content/brumacafe/us"/>
            <button
                jcr:primaryType="nt:unstructured"
                sling:resourceType="brumacafe/components/button"
                jcr:title="Ir para Loja"
                text="Ir para Loja"
                linkURL="/content/brumacafe/us/en.html"/>
        </root>
    </jcr:content>
</jcr:root>
