<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Chamada para a Loja"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Título da Chamada"
                        name="./title"
                        emptyText="Ex: Ficou com vontade?"
                        required="{Boolean}true"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldLabel="Texto de Apoio"
                        name="./text"
                        emptyText="Ex: Leve o nosso café para a sua casa. Aproveite as ofertas exclusivas."
                        required="{Boolean}false"/>
                    <buttonLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Texto do Botão"
                        name="./buttonLabel"
                        emptyText="Ex: Comprar Agora"
                        required="{Boolean}true"/>
                    <buttonLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Link para a Loja Virtual"
                        name="./buttonLink"
                        emptyText="Ex: https://loja.brumacafe.com.br"
                        required="{Boolean}true"/>
                    <fileReference
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                        allowUpload="{Boolean}true"
                        autoStart="{Boolean}false"
                        class="cq-droptarget"
                        fieldLabel="Imagem de Fundo (Opcional)"
                        fileNameParameter="./fileName"
                        fileReferenceParameter="./fileReference"
                        mimeTypes="[image/gif,image/jpeg,image/png,image/webp]"
                        multiple="{Boolean}false"
                        name="./file"
                        title="Arraste a imagem aqui para destacar a chamada"
                        uploadUrl="${suffix.path}"
                        useHTML5="{Boolean}true"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
